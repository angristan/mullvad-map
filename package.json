{
  "name": "mullvad-relay-atlas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typegen": "wrangler types",
    "typegen:check": "wrangler types --check",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy",
    "check": "bun run typegen:check && bun run test && bun run deploy:dry"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@mantine/core": "9.5.0",
    "@mantine/hooks": "9.5.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.101.4",
    "effect": "4.0.0-beta.102",
    "hono": "4.12.33",
    "maplibre-gl": "6.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "28.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
